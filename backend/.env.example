# Шаблон файла .env для локальной разработки.
# Скопировать этот файл в backend/.env и заполнить реальными значениями.
# Файл .env в репозиторий не коммитится (см. .gitignore).

# --- База данных PostgreSQL ---
DB_NAME=codementor
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5434

# --- ИИ-наставник (Groq, бесплатный ключ на console.groq.com) ---
GROQ_API_KEY=

# --- Email (опционально, для прода) ---
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=465
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
